# 本地开发模板。请先生成两个独立随机密钥，再运行 pnpm dev。
AUTH_PUBLIC_URL=http://localhost:4300
AUTH_ISSUER=http://localhost:4300
AUTH_SECRET=replace-with-a-random-secret
INTERNAL_AUTH_SECRET=replace-with-another-random-secret
AUTH_SQLITE_PATH=infra/db/auth.sqlite
AUTH_DB_BACKUP_DIR=infra/db/backups
AUTH_TRUSTED_ORIGINS=http://localhost:4300
AUTH_BOOTSTRAP_DEMO_USER=false
AUTH_BOOTSTRAP_ADMIN_USER=false
AUTH_BOOTSTRAP_E2E_USER=false
AUTH_BOOTSTRAP_LOCAL_CLIENT=false
AUTH_BOOTSTRAP_STRICT_SEED_USERS=false
# 首个管理员由你配置的邮箱账号领取；请替换为自己的邮箱。
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 第三方配置使用 docs/upstream-providers.example.json 作为模板。
# AUTH_UPSTREAM_PROVIDERS_FILE=/absolute/path/to/secrets/upstream-providers.json
