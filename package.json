{
  "name": "astra-auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-auth.mjs",
    "dev": "next dev -p 4300",
    "build": "next build",
    "prestart": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-auth.mjs",
    "start": "next start",
    "hash:password": "node scripts/hash-password.mjs",
    "admin:password-reset-link": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-admin-password-reset-link.mjs",
    "migrate:auth": "tsx scripts/migrate-auth.ts",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run && node --test scripts/bootstrap-auth-migration.test.mjs",
    "test:migrations": "node --test scripts/bootstrap-auth-migration.test.mjs",
    "test:watch": "vitest --watch",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@radix-ui/react-icons": "^1.3.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.1.1",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.1.3",
    "next": "16.2.2",
    "openid-client": "6.8.4",
    "pg": "^8.18.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0"
  },
  "description": "Independent identity service with OIDC, account management and federated login",
  "license": "Unlicense",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=9 <10"
  },
  "pnpm": {
    "overrides": {
      "ajv@>=8.0.0": "^8.18.0",
      "esbuild": "^0.25.11",
      "kysely": "^0.28.15",
      "lodash": "^4.17.23",
      "rollup": "^4.60.1"
    }
  }
}
